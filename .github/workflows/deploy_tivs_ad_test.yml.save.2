---
name: build and deploy tivs admin test app

on:
  workflow_dispatch:
    inputs:
      environment:
        description: 'Target environment'
        required: false
        default: 'main'

permissions:
  contents: write
  packages: write  

env:
  REGISTRY: ghcr.io
  OWNER: technotrendng
  IMAGE_ADMIN_DASHBOARD_FE: tivs_admin_dashboard_fe
  IMAGE_PARTNERS_DASHBOARD_BE: tivs_admin_dashboard_be

  VITE_API_BASE_URL: https://api.admin.technotrendng.com
  IMAGE_TAG: ${{ github.event.client_payload.tag || 'latest' }}


jobs: 
  deploy_tivs_admin_test: 
    strategy:
      matrix:
        test-vm:
          - { label: server_dash_75, name: "tivs_admin_dh_test" }
    
    runs-on: [self-hosted, "${{ matrix.test-vm.label }}" ]
    environment: test

    
